<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalendarOcrApp.MainPage"
             Title="Calendar OCR">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            
            <Label Text="Calendar OCR" FontSize="24" FontAttributes="Bold"/>
            
            <Button Text="Seleccionar imagen"
                    Clicked="OnPickImageClicked"/>

            <Image x:Name="SelectedImage"
                   HeightRequest="250"
                   Aspect="AspectFit"
                   IsVisible="False"/>

            <Label Text="Texto detectado:"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Editor x:Name="OcrResultEditor"
                    HeightRequest="200"
                    IsReadOnly="True"
                    Placeholder="Aqui aparecera el texto OCR..."/>
            <Label Text="Eventos detectados:"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <CollectionView x:Name="EventsCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0.6">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Start, StringFormat='Inicio: {0:dd/MM/yyyy HH:mm}'}"/>
                                <Label Text="{Binding End, StringFormat='Fin: {0:dd/MM/yyyy HH:mm}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Guardar en Calendario"
                    Clicked="OnSaveEventsClicked"/>

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
