<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalendarOcrApp.MainPage"
             Title="Calendar OCR">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Calendar OCR" FontSize="24" FontAttributes="Bold"/>

            <Button x:Name="PickButton"
                    Text="Seleccionar foto del calendario"
                    Clicked="OnPickImageClicked"/>

            <Image x:Name="SelectedImage"
                   HeightRequest="250"
                   Aspect="AspectFit"
                   IsVisible="False"/>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"/>

            <Label x:Name="StatusLabel"
                   IsVisible="False"/>

            <Label Text="Mes y año"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                <Picker x:Name="MonthPicker" Title="Mes"/>
                <Entry x:Name="YearEntry"
                       Grid.Column="1"
                       Placeholder="Año"
                       Keyboard="Numeric"
                       MaxLength="4"/>
            </Grid>

            <Label x:Name="PeriodHintLabel"
                   Text="No se ha detectado el mes y/o el año en la foto. Compruébalos antes de guardar."
                   TextColor="OrangeRed"
                   FontSize="12"
                   IsVisible="False"/>

            <Label Text="Eventos detectados"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <VerticalStackLayout x:Name="EventsLayout" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12">
                            <Grid ColumnDefinitions="64,*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8">
                                <Entry Text="{Binding Day}"
                                       Keyboard="Numeric"
                                       MaxLength="2"/>
                                <Entry Grid.Column="1"
                                       Text="{Binding Title}"/>
                                <Button Grid.Column="2"
                                        Text="✕"
                                        Clicked="OnDeleteEventClicked"/>
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding TimeDescription}"
                                       FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button x:Name="SaveButton"
                    Text="Guardar en Calendario"
                    Clicked="OnSaveEventsClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
